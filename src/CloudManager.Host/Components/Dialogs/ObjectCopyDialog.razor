<MudDialog>
    <TitleContent>コピー / 移動 - @SourceName</TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="destinationBucket" Label="コピー先バケット" Required="true" FullWidth="true" />
            <MudTextField @bind-Value="destinationName" Label="コピー先オブジェクト名" Required="true" FullWidth="true" />
            <MudSwitch @bind-Value="move" Label="移動（コピー後に元を削除）" Color="Color.Warning" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="@(move ? Color.Warning : Color.Primary)" OnClick="Submit"
                   Disabled="@(!IsValid)">@(move ? "移動" : "コピー")</MudButton>
    </DialogActions>
</MudDialog>
