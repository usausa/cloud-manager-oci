<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">セッション - @Detail?.Session.DisplayName</MudText>
    </TitleContent>
    <DialogContent>
        @if (Detail is not null)
        {
            <MudSimpleTable Dense="true" Bordered="true" Class="detail-table">
                <tbody>
                    <tr><td>OCID</td><td class="break-all">@Detail.Session.Id</td></tr>
                    <tr><td>種類</td><td>@Detail.Session.SessionType</td></tr>
                    <tr><td>状態</td><td>@Detail.Session.State</td></tr>
                    <tr><td>ターゲット</td><td class="break-all">@(Detail.Session.TargetPrivateIp ?? "-") / @(Detail.Session.TargetResourceId ?? "-") : @(Detail.Session.TargetPort?.ToString() ?? "-")</td></tr>
                    <tr><td>Bastion ユーザー</td><td class="break-all">@(Detail.BastionUserName ?? "-")</td></tr>
                    <tr><td>TTL (秒)</td><td>@(Detail.Session.TtlSeconds?.ToString() ?? "-")</td></tr>
                    <tr><td>作成日時</td><td>@DisplayFormat.Time(Detail.Session.TimeCreated)</td></tr>
                </tbody>
            </MudSimpleTable>
            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">SSH コマンド</MudText>
            @if (Detail.SshCommand is null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">セッションが ACTIVE になるとコマンドが提供されます。</MudText>
            }
            else
            {
                <MudTextField Value="@Detail.SshCommand" Lines="4" ReadOnly="true" Variant="Variant.Outlined" />
                <MudText Typo="Typo.caption">&lt;privateKey&gt; は公開鍵に対応する秘密鍵のパスに置き換えてください。</MudText>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">閉じる</MudButton>
    </DialogActions>
</MudDialog>
