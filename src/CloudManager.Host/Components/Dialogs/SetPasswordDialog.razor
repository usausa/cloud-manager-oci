<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">パスワード設定 - @UserName</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.caption">ドメインのパスワードポリシーを満たす必要があります。</MudText>
            <MudTextField @bind-Value="password" Label="新しいパスワード" InputType="InputType.Password" Required="true" Immediate="true" />
            <MudTextField @bind-Value="confirm" Label="新しいパスワード (確認)" InputType="InputType.Password" Required="true" Immediate="true"
                          Error="@(confirm.Length > 0 && confirm != password)" ErrorText="パスワードが一致しません。" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@(String.IsNullOrEmpty(password) || password != confirm)">設定</MudButton>
    </DialogActions>
</MudDialog>
