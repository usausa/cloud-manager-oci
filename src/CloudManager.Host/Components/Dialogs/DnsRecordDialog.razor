<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">レコード追加/更新 - @ZoneName</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="domain" Label="ドメイン (FQDN)" Required="true" Placeholder="@($"www.{ZoneName}")" Disabled="@(Record is not null)" />
            <MudSelect T="string" @bind-Value="rtype" Label="タイプ" Required="true" Disabled="@(Record is not null)">
                <MudSelectItem Value="@("A")">A</MudSelectItem>
                <MudSelectItem Value="@("AAAA")">AAAA</MudSelectItem>
                <MudSelectItem Value="@("CNAME")">CNAME</MudSelectItem>
                <MudSelectItem Value="@("TXT")">TXT</MudSelectItem>
                <MudSelectItem Value="@("MX")">MX</MudSelectItem>
                <MudSelectItem Value="@("PTR")">PTR</MudSelectItem>
                <MudSelectItem Value="@("SRV")">SRV</MudSelectItem>
            </MudSelect>
            <MudNumericField T="int" @bind-Value="ttl" Label="TTL (秒)" Min="1" />
            <MudText Typo="Typo.caption">値 (1行1エントリ。既存のレコードセットは置き換わります)</MudText>
            <MudTextField @bind-Value="valuesText" Lines="4" Variant="Variant.Outlined" Placeholder="1.2.3.4&#10;5.6.7.8" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit"
                   Disabled="@(String.IsNullOrWhiteSpace(domain) || String.IsNullOrWhiteSpace(valuesText))">
            保存
        </MudButton>
    </DialogActions>
</MudDialog>
