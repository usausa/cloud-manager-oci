<MudDialog DefaultFocus="DefaultFocus.LastChild">
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        @Message
    </DialogContent>
    <DialogActions>
        <div tabindex="-1" @onkeydown="HandleKeyDown">
            <MudFocusTrap DefaultFocus="DefaultFocus.LastChild">
                @if (Type == MessageBoxType.Confirm)
                {
                    <MudButton OnClick="OnCancelClick">キャンセル</MudButton>
                }
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnOkClick">OK</MudButton>
            </MudFocusTrap>
        </div>
    </DialogActions>
</MudDialog>
