<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">スナップショット作成 - @DbInstanceId</MudText></TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="snapshotId" Label="スナップショット ID" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@String.IsNullOrWhiteSpace(snapshotId)">作成</MudButton>
    </DialogActions>
</MudDialog>
