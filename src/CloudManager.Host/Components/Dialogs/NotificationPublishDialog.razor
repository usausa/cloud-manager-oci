<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">メッセージ発行 - @TopicName</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="title" Label="タイトル (省略可)" />
            <MudTextField @bind-Value="body" Label="本文" Required="true" Lines="4" Variant="Variant.Outlined" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@String.IsNullOrWhiteSpace(body)">発行</MudButton>
    </DialogActions>
</MudDialog>
