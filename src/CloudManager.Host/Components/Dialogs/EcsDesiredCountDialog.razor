<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">希望タスク数変更 - @ServiceName</MudText></TitleContent>
    <DialogContent>
        <MudNumericField @bind-Value="desiredCount" Label="希望タスク数" Variant="Variant.Outlined" Min="0" Max="100"
                         Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">更新</MudButton>
    </DialogActions>
</MudDialog>
