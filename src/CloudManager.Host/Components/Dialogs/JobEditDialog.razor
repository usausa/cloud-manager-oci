<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" Model="Form">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="Form.Name" For="@(() => Form.Name)" Validation="@Validator.ValidateValue" Label="ジョブ名" Immediate="true" />
                <MudTextField @bind-Value="Form.Description" For="@(() => Form.Description)" Label="説明" />
                <MudTextField @bind-Value="Form.ProfileName" For="@(() => Form.ProfileName)" Validation="@Validator.ValidateValue" Label="プロファイル" Immediate="true" />
                <MudTextField @bind-Value="Form.RegionName" For="@(() => Form.RegionName)" Validation="@Validator.ValidateValue" Label="リージョン" Immediate="true" />
                <MudSelect T="JobServiceType" Value="Form.ServiceType" ValueChanged="OnServiceTypeChanged" Label="サービス">
                    @foreach (var serviceType in Enum.GetValues<JobServiceType>())
                    {
                        <MudSelectItem Value="serviceType">@serviceType</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="JobOperation" @bind-Value="Form.Operation" For="@(() => Form.Operation)" Validation="@Validator.ValidateValue" Label="操作">
                    @foreach (var operation in JobOperationCatalog.ForService(Form.ServiceType))
                    {
                        <MudSelectItem Value="operation">@JobOperationCatalog.DisplayName(operation)</MudSelectItem>
                    }
                </MudSelect>

                @switch (Form.Operation)
                {
                    case JobOperation.ComputeStart:
                    case JobOperation.ComputeStop:
                    case JobOperation.ComputeReboot:
                        <MudTextField @bind-Value="Form.InstanceId" For="@(() => Form.InstanceId)" Validation="@Validator.ValidateValue" Label="Compute インスタンス OCID" Immediate="true" />
                        break;
                    case JobOperation.AdbStart:
                    case JobOperation.AdbStop:
                        <MudTextField @bind-Value="Form.DatabaseId" For="@(() => Form.DatabaseId)" Validation="@Validator.ValidateValue" Label="Autonomous Database OCID" Immediate="true" />
                        break;
                    case JobOperation.ContainerInstanceStart:
                    case JobOperation.ContainerInstanceStop:
                        <MudTextField @bind-Value="Form.ContainerInstanceId" For="@(() => Form.ContainerInstanceId)" Validation="@Validator.ValidateValue" Label="Container Instance OCID" Immediate="true" />
                        break;
                    case JobOperation.FunctionsInvoke:
                        <MudTextField @bind-Value="Form.FunctionId" For="@(() => Form.FunctionId)" Validation="@Validator.ValidateValue" Label="関数 OCID" Immediate="true" />
                        <MudTextField @bind-Value="Form.Payload" For="@(() => Form.Payload)" Label="ペイロード (JSON)" Lines="3" />
                        <MudSelect T="string" @bind-Value="Form.InvokeType" Label="実行タイプ">
                            <MudSelectItem Value="@FunctionsService.InvokeTypeDetached">Detached (非同期)</MudSelectItem>
                            <MudSelectItem Value="@FunctionsService.InvokeTypeSync">Sync (同期)</MudSelectItem>
                        </MudSelect>
                        break;
                }

                <MudTextField @bind-Value="Form.CronExpression" For="@(() => Form.CronExpression)" Validation="@Validator.ValidateValue" Label="Cron 式 (例: 0 18 * * 1-5)" Immediate="true" />
                <MudSelect T="JobCronTimeZone" @bind-Value="Form.CronTimeZone" Label="タイムゾーン">
                    <MudSelectItem Value="JobCronTimeZone.Utc">UTC</MudSelectItem>
                    <MudSelectItem Value="JobCronTimeZone.Local">ローカル</MudSelectItem>
                </MudSelect>
                <MudCheckBox @bind-Value="Form.IsEnabled" Label="有効" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancelClick">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnOkClick">保存</MudButton>
    </DialogActions>
</MudDialog>
