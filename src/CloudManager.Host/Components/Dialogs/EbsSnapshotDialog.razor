<MudDialog>
    <TitleContent>スナップショット作成 - @VolumeId</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="description" Label="説明" FullWidth="true" AutoFocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">作成</MudButton>
    </DialogActions>
</MudDialog>
