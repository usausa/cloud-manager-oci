@inherits AwsComponentBase

<MudDialog>
    <TitleContent>Scan - @TableName（上位 100 件）</TitleContent>
    <DialogContent>
        @if (IsLoading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (items.Count == 0)
        {
            <MudText>アイテムがありません。</MudText>
        }
        else
        {
            @foreach (var item in items)
            {
                <MudPaper Class="pa-2 mb-1" Outlined="true">
                    @foreach (var kv in item.Attributes)
                    {
                        <MudText Typo="Typo.body2"><b>@kv.Key</b>: @kv.Value</MudText>
                    }
                </MudPaper>
            }
        }
        @if (ErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@ErrorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Close()">閉じる</MudButton>
    </DialogActions>
</MudDialog>
