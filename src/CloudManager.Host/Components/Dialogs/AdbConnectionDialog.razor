@inherits OciComponentBase

<MudDialog>
    <TitleContent>接続文字列 - @DatabaseName</TitleContent>
    <DialogContent>
        @if (IsLoading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (connectionStrings.Count == 0)
        {
            <MudText>接続文字列がありません。</MudText>
        }
        else
        {
            <MudTable T="ConnectionStringInfo" Items="connectionStrings" Dense="true" Hover="true" Bordered="true">
                <HeaderContent>
                    <MudTh>サービス</MudTh>
                    <MudTh>接続文字列</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd class="break-all">@context.Value</MudTd>
                </RowTemplate>
            </MudTable>
        }
        @if (ErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@ErrorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Close()">閉じる</MudButton>
    </DialogActions>
</MudDialog>
