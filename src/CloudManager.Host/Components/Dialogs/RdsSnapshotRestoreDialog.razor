<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">スナップショット復元 - @SnapshotId</MudText></TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="newDbInstanceId" Label="新 DB インスタンス ID" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
        <MudTextField @bind-Value="instanceClass" Label="インスタンスクラス (例: db.t3.medium)" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">キャンセル</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@String.IsNullOrWhiteSpace(newDbInstanceId)">復元</MudButton>
    </DialogActions>
</MudDialog>
