<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">シークレット値 - @Value.SecretName</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2">
                <strong>バージョン:</strong> @(Value.VersionNumber?.ToString() ?? "-")
                @if (!String.IsNullOrEmpty(Value.VersionName))
                {
                    <span> (@Value.VersionName)</span>
                }
                / <strong>作成日時:</strong> @DisplayFormat.Time(Value.TimeCreated)
            </MudText>
            @if (reveal)
            {
                <MudTextField Value="@Value.Content" Label="値" Lines="6" ReadOnly="true" Variant="Variant.Outlined" />
            }
            else
            {
                <MudTextField Value="@Masked" Label="値" ReadOnly="true" Variant="Variant.Outlined" />
            }
            <div>
                <MudButton StartIcon="@(reveal ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                           Variant="Variant.Outlined" Size="Size.Small" OnClick="() => reveal = !reveal">
                    @(reveal ? "隠す" : "表示")
                </MudButton>
            </div>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">閉じる</MudButton>
    </DialogActions>
</MudDialog>
