<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">シークレット値</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText><strong>名前:</strong> @SecretName</MudText>
            <MudText><strong>バージョン:</strong> @VersionId</MudText>
            <MudTextField Value="@SecretValue" Label="値" Lines="6" ReadOnly="true" Variant="Variant.Outlined" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">閉じる</MudButton>
    </DialogActions>
</MudDialog>
