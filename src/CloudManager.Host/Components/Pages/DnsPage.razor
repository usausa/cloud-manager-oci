@page "/dns"
@inherits OciComponentBase

<PageTitle>CloudManager OCI - DNS</PageTitle>

<ProgressOverlay Visible="IsRunning" Ratio="ProgressRatio" Message="@ProgressMessage" />

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">DNS</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Size="Size.Small"
               OnClick="LoadAsync" Disabled="IsBusy">更新</MudButton>
</MudStack>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.subtitle2" Class="mb-1">ゾーン一覧</MudText>
        <MudTable T="DnsZoneInfo" Items="zones" Dense="true" Hover="true" Bordered="true" Striped="true"
                  Loading="@IsLoading" SelectedItem="selectedZone" SelectedItemChanged="OnZoneSelectedAsync" RowsPerPage="25" Filter="FilterFunc">
            <ToolBarContent>
                <MudTextField @bind-Value="searchText" Placeholder="検索" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small"
                              Immediate="true" Clearable="true" Margin="Margin.Dense" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>名前</MudTh>
                <CompartmentTh Visible="ShowCompartment" />
                <MudTh>種別</MudTh>
                <MudTh>スコープ</MudTh>
                <MudTh>状態</MudTh>
                <MudTh>シリアル</MudTh>
                <MudTh>作成日時</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudText Class="@(context == selectedZone ? "mud-primary-text font-bold" : string.Empty)">@context.Name</MudText>
                </MudTd>
                <CompartmentTd Visible="ShowCompartment" Id="@context.CompartmentId" />
                <MudTd>@context.ZoneType</MudTd>
                <MudTd>@context.Scope</MudTd>
                <MudTd>@context.State</MudTd>
                <MudTd>@(context.Serial?.ToString() ?? "-")</MudTd>
                <MudTd>@DisplayFormat.Time(context.TimeCreated)</MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager /></PagerContent>
        </MudTable>
    </div>
    @if (selectedZone is not null)
    {
        <div>
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                <MudText Typo="Typo.subtitle2">レコード: @selectedZone.Name</MudText>
                <MudSpacer />
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Color="Color.Primary"
                           Size="Size.Small" OnClick="() => OpenUpsertDialogAsync(null)" Disabled="IsRunning">追加/更新</MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Size="Size.Small"
                           OnClick="LoadRecordsAsync" Disabled="IsBusy">更新</MudButton>
            </MudStack>
            <MudTable T="DnsRecordInfo" Items="records" Dense="true" Hover="true" Bordered="true" Striped="true"
                      Loading="@isRecordsLoading" RowsPerPage="25">
                <HeaderContent>
                    <MudTh>ドメイン</MudTh>
                    <MudTh>タイプ</MudTh>
                    <MudTh>TTL</MudTh>
                    <MudTh>値</MudTh>
                    <MudTh>操作</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Domain</MudTd>
                    <MudTd>@context.Rtype</MudTd>
                    <MudTd>@context.Ttl</MudTd>
                    <MudTd class="break-all">@String.Join(", ", context.Rdata)</MudTd>
                    <MudTd>
                        <MudTooltip Text="編集">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                           Disabled="@(IsRunning || IsProtected(context))" OnClick="() => OpenUpsertDialogAsync(context)" />
                        </MudTooltip>
                        <MudTooltip Text="削除">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           Disabled="@(IsRunning || IsProtected(context))" OnClick="() => DeleteRecordAsync(context)" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager /></PagerContent>
            </MudTable>
        </div>
    }
</MudStack>
