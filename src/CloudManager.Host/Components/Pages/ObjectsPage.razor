@page "/object-storage/{BucketName}"
@inherits OciComponentBase

<PageTitle>CloudManager OCI - Object Storage (@BucketName)</PageTitle>

<ProgressOverlay Visible="IsRunning" Ratio="ProgressRatio" Message="@ProgressMessage" />

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Href="object-storage" />
    <MudText Typo="Typo.h5">オブジェクト</MudText>
    <MudText Typo="Typo.subtitle1" Class="ml-1 mud-text-secondary">@BucketName</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Upload" Variant="Variant.Outlined" Size="Size.Small"
               Disabled="IsRunning" OnClick="UploadAsync">アップロード</MudButton>
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Size="Size.Small"
               Disabled="IsBusy" OnClick="LoadObjectsAsync">更新</MudButton>
</MudStack>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

<MudPaper Class="pa-2 mb-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(IsBusy || String.IsNullOrEmpty(prefix))" OnClick="GoUpAsync" />
        <MudTextField @bind-Value="prefix" Label="プレフィックス" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Class="search-field-wide"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                      OnAdornmentClick="LoadObjectsAsync" />
    </MudStack>
</MudPaper>

<MudTable T="ObjectRow" Items="rows" Dense="true" Hover="true" Bordered="true" Striped="true"
          Loading="@IsLoading" RowsPerPage="50">
    <HeaderContent>
        <MudTh>名前</MudTh>
        <MudTh>サイズ</MudTh>
        <MudTh>最終更新</MudTh>
        <MudTh>ストレージ層</MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        @if (context.IsPrefix)
        {
            <MudTd>
                <MudLink OnClick="() => EnterPrefixAsync(context.Name)"><MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="mr-1" />@context.DisplayName</MudLink>
            </MudTd>
            <MudTd>-</MudTd>
            <MudTd>-</MudTd>
            <MudTd>-</MudTd>
            <MudTd>
                <MudTooltip Text="配下をすべて削除">
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small" Color="Color.Error"
                                   Disabled="IsRunning" OnClick="() => DeletePrefixAsync(context.Name)" />
                </MudTooltip>
            </MudTd>
        }
        else
        {
            var obj = context.Object!;
            <MudTd><span title="@obj.Name">@context.DisplayName</span></MudTd>
            <MudTd>@DisplayFormat.Size(obj.Size)</MudTd>
            <MudTd>@DisplayFormat.Time(obj.TimeModified)</MudTd>
            <MudTd>@obj.StorageTier</MudTd>
            <MudTd>
                <MudTooltip Text="ダウンロード">
                    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                   Disabled="IsRunning" Href="@DownloadUrl(obj)" />
                </MudTooltip>
                <MudTooltip Text="プレビュー">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                   Disabled="IsRunning" OnClick="() => PreviewAsync(obj)" />
                </MudTooltip>
                <MudTooltip Text="バージョン">
                    <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small"
                                   Disabled="IsRunning" OnClick="() => ShowVersionsAsync(obj)" />
                </MudTooltip>
                <MudTooltip Text="コピー / 移動">
                    <MudIconButton Icon="@Icons.Material.Filled.FileCopy" Size="Size.Small"
                                   Disabled="IsRunning" OnClick="() => CopyMoveAsync(obj)" />
                </MudTooltip>
                <MudTooltip Text="削除">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   Disabled="IsRunning" OnClick="() => DeleteObjectAsync(obj)" />
                </MudTooltip>
            </MudTd>
        }
    </RowTemplate>
    <PagerContent><MudTablePager /></PagerContent>
</MudTable>
