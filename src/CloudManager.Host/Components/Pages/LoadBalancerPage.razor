@page "/load-balancer"
@inherits OciComponentBase

<PageTitle>CloudManager OCI - Load Balancer</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">Load Balancer</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Size="Size.Small"
               OnClick="LoadAsync" Disabled="IsBusy">更新</MudButton>
</MudStack>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

<MudTable T="LoadBalancerInfo" Items="loadBalancers" Dense="true" Hover="true" Bordered="true" Striped="true"
          Loading="@IsLoading" RowsPerPage="25" SelectedItem="selected" SelectedItemChanged="OnSelectedAsync">
    <HeaderContent>
        <MudTh>名前</MudTh>
        <CompartmentTh Visible="ShowCompartment" />
        <MudTh>種類</MudTh>
        <MudTh>状態</MudTh>
        <MudTh>シェイプ</MudTh>
        <MudTh>可視性</MudTh>
        <MudTh>IP アドレス</MudTh>
        <MudTh>バックエンドセット</MudTh>
        <MudTh>リスナー</MudTh>
        <MudTh>作成日時</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd><span title="@context.Id">@context.DisplayName</span></MudTd>
        <CompartmentTd Visible="ShowCompartment" Id="@context.CompartmentId" />
        <MudTd>@context.Type</MudTd>
        <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.State == "ACTIVE" ? Color.Success : Color.Default)">@context.State</MudChip></MudTd>
        <MudTd>@(context.ShapeName ?? "-")</MudTd>
        <MudTd>@(context.IsPrivate ? "プライベート" : "パブリック")</MudTd>
        <MudTd>@context.IpAddresses</MudTd>
        <MudTd>@context.BackendSetCount</MudTd>
        <MudTd>@context.ListenerCount</MudTd>
        <MudTd>@DisplayFormat.Time(context.TimeCreated)</MudTd>
    </RowTemplate>
    <PagerContent><MudTablePager /></PagerContent>
</MudTable>

@if (selected is not null)
{
    <MudText Typo="Typo.subtitle1" Class="mt-3 mb-1">バックエンドセット - @selected.DisplayName</MudText>
    <MudTable T="BackendSetInfo" Items="backendSets" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="@isDetailLoading">
        <HeaderContent>
            <MudTh>名前</MudTh>
            <MudTh>ポリシー</MudTh>
            <MudTh>バックエンド数</MudTh>
            <MudTh>ヘルス</MudTh>
            <MudTh>ヘルスチェック</MudTh>
            <MudTh>操作</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.Policy</MudTd>
            <MudTd>@context.BackendCount</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="@HealthColor(context.HealthStatus)">@context.HealthStatus</MudChip></MudTd>
            <MudTd>@context.HealthCheckProtocol:@context.HealthCheckPort @context.HealthCheckPath</MudTd>
            <MudTd>
                <MudTooltip Text="バックエンドヘルス">
                    <MudIconButton Icon="@Icons.Material.Filled.MonitorHeart" Size="Size.Small"
                                   OnClick="() => ShowBackendHealthAsync(context)" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>バックエンドセットがありません。</MudText></NoRecordsContent>
    </MudTable>
}
