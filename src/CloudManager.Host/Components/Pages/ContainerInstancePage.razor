@page "/container-instances"
@inherits OciComponentBase

<PageTitle>CloudManager OCI - Container Instances</PageTitle>

<ProgressOverlay Visible="IsRunning" Ratio="ProgressRatio" Message="@ProgressMessage" />

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">Container Instances</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Size="Size.Small"
               OnClick="LoadAsync" Disabled="IsBusy">更新</MudButton>
</MudStack>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

<MudTable T="ContainerInstanceInfo" Items="instances" Dense="true" Hover="true" Bordered="true" Striped="true"
          Loading="@IsLoading" RowsPerPage="25">
    <HeaderContent>
        <MudTh>名前</MudTh>
        <CompartmentTh Visible="ShowCompartment" />
        <MudTh>状態</MudTh>
        <MudTh>シェイプ</MudTh>
        <MudTh>コンテナ数</MudTh>
        <MudTh>AD</MudTh>
        <MudTh>作成日時</MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd><span title="@context.Id">@context.DisplayName</span></MudTd>
        <CompartmentTd Visible="ShowCompartment" Id="@context.CompartmentId" />
        <MudTd><MudChip T="string" Size="Size.Small" Color="@StateColor(context.State)">@context.State</MudChip></MudTd>
        <MudTd>@context.Shape @(context.Ocpus.HasValue ? $"({context.Ocpus} OCPU / {context.MemoryGb} GB)" : string.Empty)</MudTd>
        <MudTd>@context.ContainerCount</MudTd>
        <MudTd>@context.AvailabilityDomain</MudTd>
        <MudTd Class="no-wrap">@DisplayFormat.Time(context.TimeCreated)</MudTd>
        <MudTd Class="no-wrap">
            <MudTooltip Text="起動">
                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small"
                               Disabled="IsRunning" OnClick="() => StartAsync(context)" />
            </MudTooltip>
            <MudTooltip Text="停止">
                <MudIconButton Icon="@Icons.Material.Filled.Stop" Size="Size.Small"
                               Disabled="IsRunning" OnClick="() => StopAsync(context)" />
            </MudTooltip>
            <MudTooltip Text="再起動">
                <MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small"
                               Disabled="IsRunning" OnClick="() => RestartAsync(context)" />
            </MudTooltip>
            <MudTooltip Text="コンテナ一覧">
                <MudIconButton Icon="@Icons.Material.Filled.ViewList" Size="Size.Small"
                               Disabled="IsRunning" OnClick="() => ShowContainersAsync(context)" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <PagerContent><MudTablePager /></PagerContent>
</MudTable>
