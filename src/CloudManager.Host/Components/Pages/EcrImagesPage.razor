@page "/ecr/{Repository}"
@inherits AwsComponentBase

<PageTitle>CloudManager - ECR イメージ</PageTitle>

<ProgressOverlay IsVisible="IsRunning" Ratio="0.5" Message="削除中..." />

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/ecr" Size="Size.Small" />
    <MudText Typo="Typo.h5">@Repository</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Size="Size.Small"
               OnClick="LoadAsync" Disabled="IsBusy">更新</MudButton>
</MudStack>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

@if (lifecyclePolicy is not null)
{
    <MudExpansionPanels Class="mb-2">
        <MudExpansionPanel Text="ライフサイクルポリシー">
            <pre class="policy-text">@lifecyclePolicy</pre>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

<MudTable T="EcrImageInfo" Items="images" Dense="true" Hover="true" Bordered="true" Striped="true"
          Loading="@IsLoading" RowsPerPage="25">
    <HeaderContent>
        <MudTh>タグ</MudTh>
        <MudTh>ダイジェスト</MudTh>
        <MudTh>プッシュ日時</MudTh>
        <MudTh>サイズ(MB)</MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@(context.Tag ?? "(untagged)")</MudTd>
        <MudTd Class="digest">@(context.Digest.Length > 20 ? context.Digest[..20] + "…" : context.Digest)</MudTd>
        <MudTd>@(context.PushedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</MudTd>
        <MudTd>@((context.SizeBytes / 1024.0 / 1024.0).ToString("F2"))</MudTd>
        <MudTd>
            <MudTooltip Text="削除">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               Disabled="IsRunning" OnClick="() => DeleteAsync(context)" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <PagerContent><MudTablePager /></PagerContent>
</MudTable>
