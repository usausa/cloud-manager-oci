@page "/"
@inherits OciComponentBase

<PageTitle>CloudManager OCI - ダッシュボード</PageTitle>

<MudText Typo="Typo.h5" Class="mb-2">ダッシュボード</MudText>

@if (!Session.IsProfileAvailable)
{
    <MudAlert Severity="Severity.Warning" Class="mb-2">
        プロファイル '@Session.ProfileName' が ~/.oci/config に見つかりません。
        <MudLink Href="settings" Class="ml-2">設定を開く</MudLink>
    </MudAlert>
}
else
{
    <MudPaper Class="pa-2 mb-3">
        <MudGrid Spacing="1">
            <MudItem xs="12" sm="3"><MudText Typo="Typo.body2"><b>プロファイル: </b>@Session.ProfileName</MudText></MudItem>
            <MudItem xs="12" sm="3"><MudText Typo="Typo.body2"><b>リージョン: </b>@(Session.Region?.RegionId ?? "-")</MudText></MudItem>
            <MudItem xs="12" sm="6"><MudText Typo="Typo.body2"><b>コンパートメント: </b>@ScopeName</MudText></MudItem>
        </MudGrid>
    </MudPaper>

    <ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

    <MudGrid Spacing="2" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3">
                @if (IsLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" />
                }
                else
                {
                    <MudText Typo="Typo.subtitle2">Compute 稼働中</MudText>
                    <MudText Typo="Typo.h4" Color="Color.Success">@computeRunning</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">停止中: @computeStopped</MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3">
                @if (IsLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" />
                }
                else
                {
                    <MudText Typo="Typo.subtitle2">Autonomous Database 稼働中</MudText>
                    <MudText Typo="Typo.h4" Color="Color.Success">@adbAvailable</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">停止中: @adbStopped</MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3">
                @if (IsLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" />
                }
                else
                {
                    <MudText Typo="Typo.subtitle2">Container Instances 稼働中</MudText>
                    <MudText Typo="Typo.h4" Color="Color.Primary">@containerActive</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">停止中: @containerInactive</MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3">
                @if (IsLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" />
                }
                else
                {
                    <MudText Typo="Typo.subtitle2">アラーム発報中</MudText>
                    <MudText Typo="Typo.h4" Color="@(alarmFiring > 0 ? Color.Error : Color.Default)">@alarmFiring</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">FIRING 状態</MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-3">
                @if (IsLoading)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" />
                }
                else
                {
                    <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                        <div>
                            <MudText Typo="Typo.subtitle2">今月のコスト (@CurrentMonthLabel / @(IsTenancyScope ? "テナンシ全体" : "現在のコンパートメント"))</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Primary" Class="no-wrap">
                                @FormatAmount(costCurrentMonth)
                                <MudText Typo="Typo.subtitle1" Inline="true">@costCurrency</MudText>
                            </MudText>
                            @if (costError is not null)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Error">@costError</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">先月 (@PreviousMonthLabel): @FormatAmount(costPreviousMonth) @costCurrency</MudText>
                            }
                        </div>
                        <MudSpacer />
                        <MudButton Href="cost" Variant="Variant.Text" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowForward">詳細</MudButton>
                    </MudStack>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

<MudText Typo="Typo.subtitle1" Class="mb-1">サービス一覧</MudText>

@foreach (var category in Categories)
{
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1">@category.Name</MudText>
    <MudGrid Spacing="1" Class="mb-3">
        @foreach (var item in category.Items)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-2 service-item">
                    <MudLink Href="@item.Href"><MudIcon Icon="@item.Icon" Class="mr-1" />@item.Name</MudLink>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}
