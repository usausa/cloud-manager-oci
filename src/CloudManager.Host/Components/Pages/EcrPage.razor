@page "/ecr"
@inherits AwsComponentBase

<PageTitle>CloudManager - ECR</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">ECR</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Size="Size.Small"
               OnClick="LoadAsync" Disabled="IsBusy">更新</MudButton>
</MudStack>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

<MudTable T="EcrRepositoryInfo" Items="repositories" Dense="true" Hover="true" Bordered="true" Striped="true"
          Loading="@IsLoading" Filter="FilterFunc" RowsPerPage="25">
    <ToolBarContent>
        <MudTextField @bind-Value="searchText" Placeholder="検索" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small"
                      Immediate="true" Clearable="true" Margin="Margin.Dense" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>リポジトリ名</MudTh>
        <MudTh>URI</MudTh>
        <MudTh>作成日</MudTh>
        <MudTh>スキャン</MudTh>
        <MudTh>暗号化</MudTh>
        <MudTh>操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.Address</MudTd>
        <MudTd>@(context.CreatedAt?.ToString("yyyy-MM-dd") ?? "-")</MudTd>
        <MudTd>
            <MudChip T="string" Size="Size.Small" Color="@(context.ImageScanOnPush ? Color.Success : Color.Default)">
                @(context.ImageScanOnPush ? "有効" : "無効")
            </MudChip>
        </MudTd>
        <MudTd>@context.EncryptionType</MudTd>
        <MudTd>
            <MudTooltip Text="イメージ一覧">
                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                               Href="@($"ecr/{Uri.EscapeDataString(context.Name)}")" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <PagerContent><MudTablePager /></PagerContent>
</MudTable>
