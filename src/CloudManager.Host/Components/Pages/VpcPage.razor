@page "/vpc"
@inherits AwsComponentBase

<PageTitle>CloudManager - VPC</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">VPC</MudText>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Size="Size.Small"
               OnClick="LoadAsync" Disabled="IsBusy">更新</MudButton>
</MudStack>

<ErrorBanner Message="@ErrorMessage" OnClear="() => ErrorMessage = null" />

<MudTabs Outlined="true" Class="mt-1">
    <MudTabPanel Text="VPC">
        <MudText Typo="Typo.body2" Class="mb-1 mud-text-secondary">行を選択するとサブネット、セキュリティグループ、ルートテーブル、ゲートウェイを表示します。</MudText>
        <MudTable T="VpcInfo" Items="vpcs" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="@IsLoading"
                  SelectedItem="selectedVpc" SelectedItemChanged="OnVpcSelectedAsync">
            <HeaderContent>
                <MudTh>VPC ID</MudTh>
                <MudTh>CIDR</MudTh>
                <MudTh>状態</MudTh>
                <MudTh>Default</MudTh>
                <MudTh>Name</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.VpcId</MudTd>
                <MudTd>@context.CidrBlock</MudTd>
                <MudTd>@context.State</MudTd>
                <MudTd>@(context.IsDefault ? "Yes" : "No")</MudTd>
                <MudTd>@context.Name</MudTd>
            </RowTemplate>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="サブネット">
        <MudTable T="VpcSubnetInfo" Items="subnets" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="@isDetailLoading" RowsPerPage="50">
            <HeaderContent>
                <MudTh>サブネット ID</MudTh>
                <MudTh>CIDR</MudTh>
                <MudTh>AZ</MudTh>
                <MudTh>Name</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.SubnetId</MudTd>
                <MudTd>@context.CidrBlock</MudTd>
                <MudTd>@context.AvailabilityZone</MudTd>
                <MudTd>@context.Name</MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager /></PagerContent>
            <NoRecordsContent>
                <MudText>@(selectedVpc is null ? "VPC を選択してください。" : "サブネットがありません。")</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="セキュリティグループ">
        <MudTable T="VpcSecurityGroupInfo" Items="securityGroups" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="@isDetailLoading" RowsPerPage="50">
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>名前</MudTh>
                <MudTh>説明</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.GroupId</MudTd>
                <MudTd>@context.GroupName</MudTd>
                <MudTd>@context.Description</MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager /></PagerContent>
            <NoRecordsContent>
                <MudText>@(selectedVpc is null ? "VPC を選択してください。" : "セキュリティグループがありません。")</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudTabPanel>
    <MudTabPanel Text="ルートテーブル">
        <MudTable T="VpcRouteTableInfo" Items="routeTables" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="@isDetailLoading" RowsPerPage="50">
            <HeaderContent>
                <MudTh>ルートテーブル ID</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>Main</MudTh>
                <MudTh>ルート数</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.RouteTableId</MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@(context.IsMain ? "Yes" : "No")</MudTd>
                <MudTd>@context.RouteCount</MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager /></PagerContent>
            <NoRecordsContent>
                <MudText>@(selectedVpc is null ? "VPC を選択してください。" : "ルートテーブルがありません。")</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="インターネットゲートウェイ">
        <MudTable T="VpcIgwInfo" Items="internetGateways" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="@isDetailLoading" RowsPerPage="50">
            <HeaderContent>
                <MudTh>IGW ID</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>状態</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.InternetGatewayId</MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.State</MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager /></PagerContent>
            <NoRecordsContent>
                <MudText>@(selectedVpc is null ? "VPC を選択してください。" : "インターネットゲートウェイがありません。")</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="NAT ゲートウェイ">
        <MudTable T="VpcNatGwInfo" Items="natGateways" Dense="true" Hover="true" Bordered="true" Striped="true" Loading="@isDetailLoading" RowsPerPage="50">
            <HeaderContent>
                <MudTh>NAT GW ID</MudTh>
                <MudTh>Name</MudTh>
                <MudTh>サブネット ID</MudTh>
                <MudTh>状態</MudTh>
                <MudTh>パブリック IP</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.NatGatewayId</MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.SubnetId</MudTd>
                <MudTd>@context.State</MudTd>
                <MudTd>@context.PublicIp</MudTd>
            </RowTemplate>
            <PagerContent><MudTablePager /></PagerContent>
            <NoRecordsContent>
                <MudText>@(selectedVpc is null ? "VPC を選択してください。" : "NAT ゲートウェイがありません。")</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudTabPanel>
</MudTabs>
